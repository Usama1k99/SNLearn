<%- include('../partials/head', { title: 'ServiceNow Learning Hub | Developer Knowledge Base', styles: ['/styles/home.css'] }) %>
<%- include('../partials/navbar', { activeTab: 'home' }) %>

    <!-- Split Layout Main Container -->
    <main class="split-layout">
        <!-- Left Side: Hero & Features -->
        <aside class="split-left">
            <div class="split-left-content">
                <div class="hero-badge">
                    <span class="badge-dot"></span>
                    Developer Knowledge Base
                </div>
                <h1 class="hero-title">
                    Master <span class="gradient-text">ServiceNow</span><br>
                    Module by Module
                </h1>
                <p class="hero-subtitle">
                    Interactive deep-dives into ServiceNow modules — data models, workflows, 
                    lifecycle management, and developer patterns. Built by devs, for devs.
                </p>
                <div class="hero-features">
                    <ul class="feature-list">
                        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Explore lifecycle diagrams for clear understanding</li>
                        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Try simulator experiences for understanding data models easily</li>
                        <li><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Master workflows and comprehensive developer patterns</li>
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Right Side: Vertical Module Cards -->
        <section class="split-right">
            <div class="modules-stack">
                <!-- ITSM Module Card -->
                <a href="/itsm" class="module-card-horizontal" id="itsm-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-container">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                            <rect x="6" y="8" width="28" height="20" rx="4" stroke="url(#itsm-grad)" stroke-width="2"/>
                            <path d="M14 28V32H26V28" stroke="url(#itsm-grad)" stroke-width="2" stroke-linecap="round"/>
                            <path d="M10 32H30" stroke="url(#itsm-grad)" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="20" cy="18" r="4" fill="url(#itsm-grad)" opacity="0.3"/>
                            <path d="M12 18H16M24 18H28" stroke="url(#itsm-grad)" stroke-width="2" stroke-linecap="round"/>
                            <defs>
                                <linearGradient id="itsm-grad" x1="6" y1="8" x2="34" y2="32">
                                    <stop stop-color="#10b981"/>
                                    <stop offset="1" stop-color="#06b6d4"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3 class="card-title">IT Service Management</h3>
                        </div>
                        <p class="card-desc">
                            Incident & Major Incidents, Problem RCA, Change Models & CAB, Service Catalog fulfillment, Knowledge KCS, and CSDM 4.0.
                        </p>
                        <div class="card-cta">
                            Explore Module
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </a>

                <!-- HAM Module Card -->
                <a href="/ham" class="module-card-horizontal" id="ham-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-container">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                            <rect x="10" y="8" width="20" height="24" rx="2" stroke="url(#ham-grad)" stroke-width="2"/>
                            <path d="M14 14h12M14 20h12M14 26h8" stroke="url(#ham-grad)" stroke-width="2" stroke-linecap="round"/>
                            <defs>
                                <linearGradient id="ham-grad" x1="10" y1="8" x2="30" y2="32">
                                    <stop stop-color="#10b981"/>
                                    <stop offset="1" stop-color="#34d399"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3 class="card-title">Hardware Asset Management</h3>
                        </div>
                        <p class="card-desc">
                            Hardware models, stockrooms, asset lifecycles, procurement workflows, and CMDB integration.
                        </p>
                        <div class="card-cta">
                            Explore Module
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </a>

                <!-- SAM Module Card -->
                <a href="/sam" class="module-card-horizontal" id="sam-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-container">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                            <rect x="8" y="16" width="24" height="18" rx="3" stroke="url(#sam-grad)" stroke-width="2"/>
                            <path d="M14 16V12C14 8.686 16.686 6 20 6C23.314 6 26 8.686 26 12V16" stroke="url(#sam-grad)" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="20" cy="26" r="2" fill="url(#sam-grad)"/>
                            <defs>
                                <linearGradient id="sam-grad" x1="8" y1="6" x2="32" y2="34">
                                    <stop stop-color="#10b981"/>
                                    <stop offset="1" stop-color="#34d399"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3 class="card-title">Software Asset Management</h3>
                        </div>
                        <p class="card-desc">
                            Discovery, normalization, reconciliation workflows, software models, and license entitlements.
                        </p>
                        <div class="card-cta">
                            Explore Module
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </a>

                <!-- IRM Module Card -->
                <a href="/irm" class="module-card-horizontal" id="irm-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-container">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                            <path d="M20 4L36 12V28L20 36L4 28V12L20 4Z" stroke="url(#irm-grad)" stroke-width="2" fill="none"/>
                            <path d="M20 12L28 16V24L20 28L12 24V16L20 12Z" fill="url(#irm-grad)" opacity="0.3"/>
                            <circle cx="20" cy="20" r="3" fill="url(#irm-grad)"/>
                            <defs>
                                <linearGradient id="irm-grad" x1="4" y1="4" x2="36" y2="36">
                                    <stop stop-color="#10b981"/>
                                    <stop offset="1" stop-color="#6ee7b7"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3 class="card-title">Integrated Risk Management</h3>
                        </div>
                        <p class="card-desc">
                            Entity framework, risk lifecycle, policy & compliance management, 
                            audit workflows, and data model deep-dives.
                        </p>
                        <div class="card-cta">
                            Explore Module
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </a>

                <!-- SecOps Module Card -->
                <a href="/secops" class="module-card-horizontal" id="secops-card">
                    <div class="card-glow"></div>
                    <div class="card-icon-container">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                            <path d="M20 4C20 4 32 8 32 18C32 28 20 36 20 36C20 36 8 28 8 18C8 8 20 4 20 4Z" stroke="url(#sec-grad)" stroke-width="2" fill="none"/>
                            <path d="M20 12C20 12 26 14.5 26 19.5C26 24.5 20 28 20 28C20 28 14 24.5 14 19.5C14 14.5 20 12 20 12Z" fill="url(#sec-grad)" opacity="0.3"/>
                            <path d="M17 20L19 22L23 18" stroke="url(#sec-grad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <defs>
                                <linearGradient id="sec-grad" x1="8" y1="4" x2="32" y2="36">
                                    <stop stop-color="#10b981"/>
                                    <stop offset="1" stop-color="#34d399"/>
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3 class="card-title">Security Operations</h3>
                        </div>
                        <p class="card-desc">
                            Security Incident Response, Vulnerability Response, Threat Intelligence, 
                            SOAR orchestration, and integration patterns.
                        </p>
                        <div class="card-cta">
                            Explore Module
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                </a>

            </div>
        </section>
    </main>

<%- include('../partials/footer', { scripts: [] }) %>
