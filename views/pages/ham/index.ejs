<%- include('../../partials/head', { title: 'Hardware Asset Management (HAM Pro) | SN Learn', styles: ['/styles/module-layout.css'] }) %>
<%- include('../../partials/navbar', { activeTab: 'ham' }) %>

<main class="irm-hub">
    <div class="container">
        
        <div class="irm-hub-header">
            <div class="breadcrumb">
                <a href="/">Home</a>
                <span class="breadcrumb-sep">›</span>
                <span>HAM</span>
            </div>
            <div class="irm-title-row">
                <div class="irm-icon-badge">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                </div>
                <div>
                    <h1 class="irm-hub-title">Hardware Asset <span class="gradient-text">Management (HAM Pro)</span></h1>
                    <p class="irm-hub-subtitle">
                        End-to-end operational and financial governance of physical enterprise assets. Master Common Services Data Model (CSDM 4.0) lifecycle synchronization, multi-echelon stockroom logistics, mobile barcode auditing, automated hardware refresh, and audited 6-stage disposal.
                    </p>
                </div>
            </div>
        </div>

        <div class="pages-grid">
            <!-- Page 1: Overview & Architecture -->
            <a href="/ham/overview" class="module-card-horizontal page-card">
                <span class="page-card-number">01</span>
                <h3 class="page-card-title">Overview &amp; Architecture</h3>
                <p class="page-card-desc">
                    The dual architecture of HAM Pro: Financial Asset Governance vs. Operational CI Management. Explore CSDM 4.0 lifecycle stages, the Content Service normalization library, and the Asset-CI Synchronizer.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">CSDM 4.0 Model</span>
                    <span class="topic-tag">Asset-CI Sync</span>
                    <span class="topic-tag">Hardware Normalization</span>
                </div>
            </a>

            <!-- Page 2: Asset & CI Data Model -->
            <a href="/ham/data-model" class="module-card-horizontal page-card">
                <span class="page-card-number">02</span>
                <h3 class="page-card-title">Asset &amp; CI Data Model</h3>
                <p class="page-card-desc">
                    Comprehensive relational schema across alm_asset, alm_hardware, cmdb_model_category, and cmdb_ci. Includes complete field-level dictionary maps and the state-substate translation matrix.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">Master ERD</span>
                    <span class="topic-tag">Model Categories</span>
                    <span class="topic-tag">State-Substatus Matrix</span>
                </div>
            </a>

            <!-- Page 3: Procurement Lifecycle -->
            <a href="/ham/procurement" class="module-card-horizontal page-card">
                <span class="page-card-number">03</span>
                <h3 class="page-card-title">Procurement &amp; Sourcing</h3>
                <p class="page-card-desc">
                    The financial acquisition pipeline: Service Catalog requests, sourcing evaluation (stock vs. transfer vs. vendor PO), purchase order lines, receiving slip processing, and automated asset record creation.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">Sourcing Engine</span>
                    <span class="topic-tag">Purchase Orders</span>
                    <span class="topic-tag">Receiving Automation</span>
                </div>
            </a>

            <!-- Page 4: Stockrooms & Inventory -->
            <a href="/ham/inventory" class="module-card-horizontal page-card">
                <span class="page-card-number">04</span>
                <h3 class="page-card-title">Stockrooms, Transfers &amp; Audits</h3>
                <p class="page-card-desc">
                    Multi-tier inventory logistics: Hub-and-spoke stockrooms, automated restocking rules, multi-stage Transfer Orders, mobile barcode/RFID audits with blind reconciliation, and loaner device workflows.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">Stock Rules</span>
                    <span class="topic-tag">Transfer Orders</span>
                    <span class="topic-tag">Mobile Inventory Audits</span>
                </div>
            </a>

            <!-- Page 5: Disposal & Retirement -->
            <a href="/ham/disposal" class="module-card-horizontal page-card">
                <span class="page-card-number">05</span>
                <h3 class="page-card-title">Disposal, Refresh &amp; Sustainability</h3>
                <p class="page-card-desc">
                    Hardware Asset Disposal Orders (HADO) through all 6 mandatory stages: Verify, Schedule, Transit, Vendor Confirmation, and Certificate of Destruction (CoD) documentation with NIST 800-88 sanitization.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">6-Stage HADO</span>
                    <span class="topic-tag">Asset Refresh Orders</span>
                    <span class="topic-tag">Scope 3 ESG Metrics</span>
                </div>
            </a>

            <!-- Page 6: Developer Patterns & APIs -->
            <a href="/ham/developer-patterns" class="module-card-horizontal page-card">
                <span class="page-card-number">06</span>
                <h3 class="page-card-title">Developer Patterns &amp; APIs</h3>
                <p class="page-card-desc">
                    Scoped sn_hamp APIs, safe AssetAndCISynchronizer customization, automated stock rule evaluator scripts, barcode sanitize transform maps, scheduled jobs, and debugging race conditions.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">Scoped APIs</span>
                    <span class="topic-tag">Sync Business Rules</span>
                    <span class="topic-tag">Diagnostic Scripts</span>
                </div>
            </a>

            <!-- Page 7: Process Simulator -->
            <a href="/ham/simulator" class="module-card-horizontal page-card">
                <span class="page-card-number">07</span>
                <h3 class="page-card-title">Process Simulator</h3>
                <p class="page-card-desc">
                    Interactive enterprise testbed featuring 8 relational HAM tables with 35+ realistic records. Trace hardware models, assets, CMDB CIs, stockrooms, transfer orders, POs, and disposal orders.
                </p>
                <div class="page-card-topics">
                    <span class="topic-tag">8 Enterprise Tables</span>
                    <span class="topic-tag">Interactive Inspector</span>
                    <span class="topic-tag">State Machine Tracing</span>
                </div>
            </a>
        </div>
        
    </div>
</main>

