                <!-- Performance Analytics -->
                <section class="content-section" id="performance-analytics">
                    <h2>Performance Analytics: KPIs, KRIs & KCIs</h2>
                    <p>
                        ServiceNow IRM includes <strong>out-of-the-box Performance Analytics</strong> dashboards 
                        that provide data-driven insights for risk and compliance stakeholders.
                    </p>

                    <h3>Key Metrics</h3>
                    <div class="table-responsive">
                        <table class="styled-table">
                            <thead>
                                <tr>
                                    <th>Metric Type</th>
                                    <th>What It Measures</th>
                                    <th>Examples</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>KPI (Key Performance Indicator)</strong></td>
                                    <td>How well the risk program is performing</td>
                                    <td>% of controls tested on schedule, Average issue resolution time, Audit completion rate</td>
                                </tr>
                                <tr>
                                    <td><strong>KRI (Key Risk Indicator)</strong></td>
                                    <td>Early warning signals that risk is increasing</td>
                                    <td>Number of critical risks above appetite, Trend of failed controls, Vendor risk score changes</td>
                                </tr>
                                <tr>
                                    <td><strong>KCI (Key Control Indicator)</strong></td>
                                    <td>Effectiveness of individual controls</td>
                                    <td>Control failure rate, Days since last attestation, Number of open remediation tasks per control</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h3>OOTB Dashboards</h3>
                    <ul>
                        <li><strong>Compliance Overview</strong> — Aggregate view of control effectiveness, policy exceptions, and compliance posture by business unit.</li>
                        <li><strong>Risk Overview</strong> — Heat maps showing risk distribution by impact/likelihood, risk trends over time, and top risks by business area.</li>
                        <li><strong>Policy Exception Overview</strong> — Active exceptions, expiring exceptions, and exception approval trends.</li>
                        <li><strong>Audit Status</strong> — Open audits, audit findings by severity, and remediation progress.</li>
                    </ul>
                </section>

                <!-- Developer Patterns -->
                <section class="content-section" id="developer-monitoring">
                    <h2>Developer Patterns</h2>

                    <h3>Writing Scripted Indicators</h3>
                    <p>
                        Scripted indicators run as server-side scripts and must return a result that maps to 
                        Pass/Fail. Here's a practical example.
                    </p>

                    <div class="code-block">
                        <div class="code-label">Scripted Indicator — Check All Servers Have Encrypted Storage</div>
                        <pre><code>// This script runs against each entity (GRC Profile)
// and checks if all associated servers have encrypted storage

(function() {
    var entitySysId = current.getValue('source_id'); // The entity's source CI
    
    var serverGR = new GlideRecord('cmdb_ci_server');
    serverGR.addQuery('company', entitySysId);
    serverGR.addQuery('operational_status', '1'); // Operational only
    serverGR.query();
    
    var totalServers = 0;
    var encryptedServers = 0;
    
    while (serverGR.next()) {
        totalServers++;
        if (serverGR.getValue('disk_encryption') == 'true') {
            encryptedServers++;
        }
    }
    
    // Pass if ALL operational servers have encryption
    if (totalServers == 0) {
        result = 'not_applicable';
    } else if (encryptedServers == totalServers) {
        result = 'pass';  // 100% encrypted
    } else {
        result = 'fail';  // Some servers unencrypted
        result_details = encryptedServers + '/' + totalServers + 
            ' servers have encrypted storage';
    }
})();</code></pre>
                    </div>

                    <h3>Custom PA (Performance Analytics) Indicator</h3>
                    <div class="code-block">
                        <div class="code-label">Script Include — Calculate Control Effectiveness Score</div>
                        <pre><code>var ControlEffectivenessUtils = Class.create();
ControlEffectivenessUtils.prototype = {
    initialize: function() {},

    // Returns effectiveness percentage (0-100)
    calculateEffectiveness: function(entitySysId) {
        var controlGR = new GlideRecord('sn_compliance_control');
        controlGR.addQuery('profile', entitySysId);
        controlGR.addQuery('state', 'monitor'); // Active controls only
        controlGR.query();

        var total = 0;
        var effective = 0;

        while (controlGR.next()) {
            total++;
            var lastResult = controlGR.getValue('last_indicator_result');
            if (lastResult == 'pass' || lastResult == 'compliant') {
                effective++;
            }
        }

        if (total == 0) return -1; // No controls to measure
        return Math.round((effective / total) * 100);
    },

    type: 'ControlEffectivenessUtils'
};</code></pre>
                    </div>

                    <h3>Troubleshooting Indicators</h3>
                    <div class="table-responsive">
                        <table class="styled-table">
                            <thead>
                                <tr>
                                    <th>Problem</th>
                                    <th>Likely Cause</th>
                                    <th>Fix</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Indicator not producing results</td>
                                    <td>Scheduled Job <code>GRC indicator nightly run</code> is disabled or failing</td>
                                    <td>Verify the job is active in System Definition → Scheduled Jobs</td>
                                </tr>
                                <tr>
                                    <td>Indicator shows "pass" but control shows "non-compliant"</td>
                                    <td>Multiple indicators on the control — one is failing while another passes</td>
                                    <td>Check ALL indicators linked to the control, not just one</td>
                                </tr>
                                <tr>
                                    <td>Scripted indicator timeout</td>
                                    <td>Script queries too many records without optimization</td>
                                    <td>Use indexed fields, <code>getValue()</code>, and limit the result set</td>
                                </tr>
                                <tr>
                                    <td>Issue not auto-created on indicator failure</td>
                                    <td>Auto-create issue is not enabled on the indicator configuration</td>
                                    <td>Enable "Auto-create issue on failure" on the indicator record</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
