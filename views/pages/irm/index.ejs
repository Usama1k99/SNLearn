<%- include('../../partials/head', { title: 'IRM — Integrated Risk Management | SN Learn', styles: ['/styles/module-layout.css'] }) %>
<%- include('../../partials/navbar', { activeTab: 'irm' }) %>

<main class="irm-hub">
