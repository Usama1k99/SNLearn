                <!-- Hierarchy -->
                <section class="content-section" id="hierarchy">
                    <h2>Compliance Hierarchy</h2>
                    <p>
                        Policy & Compliance Management follows a clear hierarchy from external regulations 
                        down to specific, testable controls. Understanding this hierarchy is the key to 
                        understanding how compliance works in IRM.
                    </p>

                    <div class="diagram-block">
                        <div class="diagram-title">Compliance Hierarchy Flow</div>
                        <div style="display: flex; flex-direction: column; gap: 12px; align-items: center;">
