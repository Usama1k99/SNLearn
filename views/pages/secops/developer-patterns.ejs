                <section class="content-section" id="rest-api">
                    <h2>REST API Patterns</h2>
                    <p>
                        SecOps tables are accessible via the standard ServiceNow Table API. 
                        Here are the most common patterns:
                    </p>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">REST — Create a Security Incident</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>POST /api/now/table/sn_si_incident

Headers:
  Content-Type: application/json
  Accept: application/json

Body:
{
    "short_description": "Suspicious login activity detected",
    "category": "Unauthorized Access",
    "subcategory": "Brute Force",
    "priority": "2",
    "severity": "2",
    "description": "Multiple failed login attempts from IP 203.0.113.50",
    "affected_ci": "{ci_sys_id}"
}</code></pre>
                        </div>
                    </div>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">REST — Query Open High-Priority Incidents</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>GET /api/now/table/sn_si_incident
    ?sysparm_query=active=true^priority<=2
    &sysparm_fields=sys_id,number,short_description,state,priority,assigned_to
    &sysparm_display_value=true
    &sysparm_limit=25
    &sysparm_order_by=priority</code></pre>
                        </div>
                    </div>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">REST — Add an Observable to an Incident</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>POST /api/now/table/sn_ti_observable

Body:
{
    "type": "IP Address",
    "value": "203.0.113.50",
    "notes": "Source IP of brute force attempts"
}

// Then link it via M2M table:
POST /api/now/table/sn_ti_m2m_observable_sn_si_incident

Body:
{
    "sn_ti_observable": "{observable_sys_id}",
    "sn_si_incident": "{incident_sys_id}"
}</code></pre>
                        </div>
                    </div>
                </section>

                <section class="content-section" id="gliderecord">
                    <h2>GlideRecord Patterns</h2>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">Find All Critical Vulnerabilities on Production Systems</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>// Query critical vulnerable items on production CIs
var gr = new GlideRecord('sn_vul_vulnerable_item');
gr.addQuery('state', 'open');
gr.addQuery('vulnerability.severity', 'critical');
gr.addQuery('cmdb_ci.used_for', 'Production');
gr.orderByDesc('risk_score');
gr.setLimit(50);
gr.query();

while (gr.next()) {
    gs.info('VI: ' + gr.number + 
            ' | CVE: ' + gr.vulnerability.id +
            ' | CI: ' + gr.cmdb_ci.getDisplayValue() +
            ' | Risk Score: ' + gr.risk_score);
}</code></pre>
                        </div>
                    </div>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">Auto-Escalate Aged Security Incidents</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>// Scheduled Job: Escalate SIR incidents open > 72 hours
var threshold = gs.daysAgoStart(3);

var gr = new GlideRecord('sn_si_incident');
gr.addQuery('active', true);
gr.addQuery('state', '!=', 'closed');
gr.addQuery('sys_created_on', '<=', threshold);
gr.addQuery('priority', '>', 1); // Not already P1
gr.query();

while (gr.next()) {
    var oldPriority = gr.priority;
    gr.priority = parseInt(gr.priority) - 1;
    gr.work_notes = 'Auto-escalated from P' + oldPriority + 
                    ' to P' + gr.priority + 
                    ' — incident open > 72 hours';
    gr.update();
    gs.info('Escalated: ' + gr.number);
}</code></pre>
                        </div>
                    </div>

                    <div class="code-block">
                        <div class="code-header"><span class="code-lang">Link MITRE Technique to Incident via Script</span><button class="code-copy">Copy</button></div>
                        <div class="code-body">
<pre><code>// Add a MITRE ATT&CK technique to a security incident
// Uses the sn_ti.MITREUtil Script Include
var mitreUtil = new sn_ti.MITREUtil();

var incidentSysId = 'abc123...'; // sn_si_incident sys_id
var techniqueId = 'T1566.001';   // Phishing: Spearphishing Attachment

// Look up the technique record
var technique = new GlideRecord('sn_ti_stix2_attack_pattern');
technique.addQuery('mitre_id', techniqueId);
technique.query();

if (technique.next()) {
    mitreUtil.addTechniqueToIncident(
        incidentSysId, 
        technique.sys_id
    );
    gs.info('Added ' + techniqueId + ' to incident');
}</code></pre>
                        </div>
                    </div>
                </section>

                <section class="content-section" id="flow-designer">
                    <h2>Flow Designer Playbooks</h2>
                    <p>Common Flow Designer patterns used in SecOps automation:</p>

                    <div class="accordion">
                        <div class="accordion-item open">
                            <button class="accordion-trigger"><span class="accordion-trigger-text">Auto-Enrich Observables on Creation</span><span class="accordion-icon">▾</span></button>
                            <div class="accordion-body"><div class="accordion-content">
                                <p><strong>Trigger:</strong> Record Created on <code>sn_ti_observable</code> where state = 'Processed'</p>
                                <p><strong>Flow:</strong></p>
                                <p>
                                    1. Check observable type (IP, Domain, Hash, URL)<br>
                                    2. Filter out internal/private addresses to save API calls<br>
                                    3. Branch by type:<br>
                                    &nbsp;&nbsp;— IP → Query AbuseIPDB + VirusTotal<br>
                                    &nbsp;&nbsp;— Domain → Query WHOIS + VirusTotal<br>
                                    &nbsp;&nbsp;— Hash → Query VirusTotal + MalwareBazaar<br>
                                    4. Update observable with enrichment results<br>
                                    5. Set state to 'Enriched' or 'Potential New Threat'<br>
                                    6. If threat score > threshold → auto-link to active incidents
                                </p>
                            </div></div>
                        </div>
                        <div class="accordion-item">
                            <button class="accordion-trigger"><span class="accordion-trigger-text">SIEM Alert to Security Incident</span><span class="accordion-icon">▾</span></button>
                            <div class="accordion-body"><div class="accordion-content">
                                <p><strong>Trigger:</strong> REST API call from SIEM (e.g., Splunk webhook)</p>
                                <p><strong>Flow:</strong></p>
                                <p>
                                    1. Parse incoming alert payload (source IP, destination, rule name, severity)<br>
                                    2. Look up affected CI in CMDB by IP/hostname<br>
                                    3. Check for duplicate — is there an existing open incident with same observables?<br>
                                    4. If duplicate → add to existing incident as work note<br>
                                    5. If new → create sn_si_incident with auto-categorization<br>
                                    6. Create observables for all IoCs in the alert<br>
                                    7. Auto-assign based on affected CI's assignment group<br>
                                    8. Trigger enrichment subflow for new observables
                                </p>
                            </div></div>
                        </div>
                        <div class="accordion-item">
                            <button class="accordion-trigger"><span class="accordion-trigger-text">Auto-Containment on Critical Incident</span><span class="accordion-icon">▾</span></button>
                            <div class="accordion-body"><div class="accordion-content">
                                <p><strong>Trigger:</strong> Record Updated on <code>sn_si_incident</code> where state changes to 'Contain'</p>
                                <p><strong>Flow:</strong></p>
                                <p>
                                    1. Retrieve all observables linked to the incident<br>
                                    2. For each malicious IP → call firewall API to add block rule<br>
                                    3. For each affected CI → call EDR API to isolate host<br>
                                    4. For each compromised account → call AD API to disable account<br>
                                    5. Log all containment actions as work notes on the incident<br>
                                    6. Create SIR tasks for manual verification of each containment action
                                </p>
                            </div></div>
                        </div>
                    </div>
                </section>

                <section class="content-section" id="siem-integration">
                    <h2>SIEM Integration Architecture</h2>
                    <p>The typical SIEM → SecOps integration follows this pattern:</p>
                    <div class="diagram-block">
                        <div class="diagram-title">SIEM Integration Flow</div>
                        <div class="flow-container">
                            <div class="flow-step">
                                <span class="flow-step-label">SIEM</span>
                                <span class="flow-step-desc">Splunk / QRadar / Sentinel</span>
                            </div>
                            <span class="flow-arrow">→</span>
                            <div class="flow-step">
                                <span class="flow-step-label">Webhook / API</span>
                                <span class="flow-step-desc">Alert forwarded via REST</span>
                            </div>
                            <span class="flow-arrow">→</span>
                            <div class="flow-step">
                                <span class="flow-step-label">Event Ingestion</span>
                                <span class="flow-step-desc">Parse, deduplicate, correlate</span>
                            </div>
                            <span class="flow-arrow">→</span>
                            <div class="flow-step">
                                <span class="flow-step-label">SIR Incident</span>
                                <span class="flow-step-desc">Created with CMDB context</span>
                            </div>
                        </div>
                    </div>
                    <div class="info-card info-card--important">
                        <div class="info-card-title">Deduplication is Critical</div>
                        <p>
                            A single attack can generate hundreds of SIEM alerts. Without proper deduplication, 
                            you'll create hundreds of duplicate SIR incidents. Always implement deduplication 
                            logic based on source IP, destination CI, alert rule, and time window.
                        </p>
                    </div>
                </section>

