            <!-- Section 3: Table Inheritance Rules -->
            <section class="content-section" id="table-inheritance-rules">
                <h2>Real-World Table Inheritance Patterns</h2>
                <p>
                    One of the most consequential architectural decisions you will make as a ServiceNow developer is choosing 
                    whether a new custom table should extend an existing platform table or stand alone.
                </p>

                <div class="data-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Pattern</th>
                                <th>Parent Table</th>
                                <th>When to Use</th>
                                <th>Automatic Benefits</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Task Extension</strong></td>
                                <td><code>task</code></td>
                                <td>Any record requiring approvals, assignees, work notes, SLAs, or lifecycle states (e.g. Facilities Requests, Security Passes).</td>
                                <td>Inherits 60+ enterprise columns, SLA engine, activity stream, auto-number generator, and assignment engine.</td>
                            </tr>
                            <tr>
                                <td><strong>Configuration Item Extension</strong></td>
                                <td><code>cmdb_ci</code></td>
                                <td>Physical or virtual IT assets that participate in service maps, relationships, or incident outage impacts.</td>
                                <td>Inherits discovery normalization, CI relationships (<code>cmdb_rel_ci</code>), and impact analysis engines.</td>
                            </tr>
                            <tr>
                                <td><strong>Standalone Custom Table</strong></td>
                                <td><em>None (Base Table)</em></td>
                                <td>Lookup tables, matrix mapping, integration staging logs, or flat reference tables.</td>
                                <td>Only contains the default 6 platform metadata fields (<code>sys_id</code>, <code>sys_created_on</code>, etc.), minimizing database overhead.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Section 4: Cross-Scope Governance & RCA -->
            <section class="content-section" id="cross-scope-governance">
                <h2>Cross-Scope Access &amp; Restricted Caller Access (RCA)</h2>
                <p>
                    When applications in different scopes communicate (e.g. your custom equipment pass app calling the core <code>alm_hardware</code> asset table), 
                    ServiceNow enforces <strong>Restricted Caller Access (RCA)</strong> to prevent unauthorized data exposure.
                </p>

                <div class="feature-grid">
                    <div class="feature-card">
                        <div class="feature-card-header">
                            <h4>Tracking Mode</h4>
                        </div>
                        <p>
                            Cross-scope requests are automatically logged in the RCA table (<code>sys_scope_privilege</code>) and allowed 
                            to execute while you develop and test.
                        </p>
                    </div>

                    <div class="feature-card">
                        <div class="feature-card-header">
                            <h4>Enforcing Mode (Production)</h4>
                        </div>
                        <p>
                            Cross-scope script execution and database operations are strictly blocked until an administrator explicitly 
                            sets the RCA record state to <strong>Allowed</strong>.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Page Navigation Footer -->
            <nav class="page-nav">
                <a href="/basics/security-and-scopes" class="page-nav-link page-nav-link--prev">
                    <span class="page-nav-label">← Previous Page</span>
                    <span class="page-nav-title">Security, Roles &amp; Update Sets</span>
                </a>
                <a href="/basics/career-roadmap" class="page-nav-link page-nav-link--next">
                    <span class="page-nav-label">Next Page →</span>
                    <span class="page-nav-title">Career &amp; Learning Roadmap</span>
                </a>
            </nav>
        </div>
    </div>
</main>

<script>
function switchLabStep(stepNum) {
    document.querySelectorAll('.sandbox-step-btn').forEach(btn => {
        const isTarget = btn.dataset.step == stepNum;
        btn.classList.toggle('active', isTarget);
        btn.style.background = isTarget ? 'var(--accent-soft)' : 'var(--bg-elevated)';
        btn.style.borderColor = isTarget ? 'var(--accent-primary)' : 'var(--border-subtle)';
        btn.style.color = isTarget ? 'var(--text-primary)' : 'var(--text-secondary)';

        const badge = btn.querySelector('.sandbox-step-badge');
        if (badge) {
            badge.style.background = isTarget ? 'var(--accent-primary)' : 'var(--bg-tertiary)';
            badge.style.color = isTarget ? '#ffffff' : 'var(--text-secondary)';
        }
    });

    document.querySelectorAll('.sandbox-panel').forEach(panel => {
        panel.style.display = 'none';
    });

    const targetPanel = document.getElementById(`lab-step-${stepNum}`);
    if (targetPanel) {
        targetPanel.style.display = 'block';
    }
}

function handleSimStatusChange() {
    const status = document.getElementById('simStatus').value;
    const label = document.getElementById('simReturnLabel');
    const badge = document.getElementById('simBadgeStatus');

    if (status === 'checked_out') {
        label.innerHTML = 'Expected Return Date <span style="color: #ef4444;">* (Required)</span>';
        badge.innerText = 'CHECKED OUT';
        badge.style.background = 'rgba(245, 158, 11, 0.15)';
        badge.style.color = '#f59e0b';
    } else if (status === 'returned') {
        label.innerHTML = 'Return Date';
        badge.innerText = 'RETURNED (CLOSED)';
        badge.style.background = 'rgba(16, 185, 129, 0.15)';
        badge.style.color = '#10b981';
    } else {
        label.innerHTML = 'Expected Return Date';
        badge.innerText = 'DRAFT';
        badge.style.background = 'var(--accent-soft)';
        badge.style.color = 'var(--accent-primary)';
    }
}

function submitSimForm() {
    const borrower = document.getElementById('simBorrower').value;
    const asset = document.getElementById('simAssetTag').value;
    const status = document.getElementById('simStatus').value;
    const returnDate = document.getElementById('simReturnDate').value;
    const alertArea = document.getElementById('simAlertArea');
    const dbOutput = document.getElementById('simDbOutput');
    const dbJson = document.getElementById('simDbJson');

    alertArea.style.display = 'none';
    dbOutput.style.display = 'none';

    // Client Script Validation Check
    if (!borrower) {
        alertArea.innerText = 'Validation Error: Borrower field is mandatory!';
        alertArea.style.display = 'block';
        return;
    }

    if (!asset) {
        alertArea.innerText = 'Validation Error: Please select an equipment asset tag!';
        alertArea.style.display = 'block';
        return;
    }

    if (status === 'checked_out' && !returnDate) {
        alertArea.innerText = 'UI Policy Rule: An Expected Return Date is required when status is Checked Out!';
        alertArea.style.display = 'block';
        return;
    }

    // Generate Mock Hexadecimal 32-char sys_id
    const mockSysId = '9b' + Array.from({length: 30}, () => Math.floor(Math.random()*16).toString(16)).join('');

    const recordData = {
        sys_id: mockSysId,
        number: document.getElementById('simRecordNumber').innerText,
        table: 'x_acme_equip_pass',
        u_borrower: borrower,
        u_asset_tag: asset,
        u_pass_status: status,
        u_expected_return: returnDate || 'N/A',
        sys_created_on: new Date().toISOString().replace('T', ' ').substring(0, 19),
        sys_created_by: 'admin'
    };

    dbJson.innerHTML = '<pre>' + JSON.stringify(recordData, null, 2) + '</pre>';
    dbOutput.style.display = 'block';
}

function resetSimForm() {
    document.getElementById('simBorrower').value = '';
    document.getElementById('simAssetTag').value = '';
    document.getElementById('simStatus').value = 'draft';
    document.getElementById('simReturnDate').value = '';
    document.getElementById('simAlertArea').style.display = 'none';
    document.getElementById('simDbOutput').style.display = 'none';
    handleSimStatusChange();
}
</script>

