                                    <td>System-generated unique run identifier (e.g. REC0001091).</td>
                                </tr>
                                <tr>
                                    <td>Run Timestamp</td>
                                    <td><code>reconciliation_date</code></td>
                                    <td>GlideDateTime</td>
                                    <td>—</td>
