            <!-- 3. Layer 1: Discovery & Normalization -->
            <section class="content-section" id="discovery-layer">
                <h2>1. Discovery, Normalization &amp; Usage Layer</h2>
                <p>
                    The discovery layer captures raw technical data from endpoints, deduplicates identical software footprints, enriches records with canonical publisher taxonomy, and tracks foreground application execution duration.
                </p>

                <!-- cmdb_sam_sw_install -->
                <div class="card-basic" style="margin-top: 24px; padding: 24px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h3 style="margin: 0;">Software Installations (<code>cmdb_sam_sw_install</code>)</h3>
                        <span class="badge badge-blue">Extends cmdb_ci</span>
                    </div>
                    <p>
                        Captures individual software applications discovered on physical computers, virtual machines, and cloud instances. Populated by Service Graph Connectors (SCCM, Jamf, Intune), native ServiceNow Discovery, or Agent Client Collector (ACC-V).
                    </p>

                    <h4>Field Dictionary (Default Schema)</h4>
                    <div class="data-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Column Label</th>
                                    <th>System Name</th>
                                    <th>Data Type</th>
                                    <th>Reference Target</th>
                                    <th>Mandatory</th>
                                    <th>Functional Purpose</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Display Name</td>
                                    <td><code>display_name</code></td>
                                    <td>String (255)</td>
                                    <td>—</td>
                                    <td>Yes</td>
                                    <td>Raw application title as reported by the OS registry, package manager, or installer.</td>
                                </tr>
                                <tr>
                                    <td>Publisher</td>
                                    <td><code>publisher</code></td>
                                    <td>String (255)</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Raw vendor string reported by discovery before Content Service normalization.</td>
                                </tr>
                                <tr>
                                    <td>Version</td>
                                    <td><code>version</code></td>
                                    <td>String (80)</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Raw build and release version string (e.g. 15.0.2000.5).</td>
                                </tr>
                                <tr>
                                    <td>Installed On</td>
                                    <td><code>installed_on</code></td>
                                    <td>Reference</td>
                                    <td><code>cmdb_ci_computer</code></td>
                                    <td>Yes</td>
                                    <td>Foreign key linking the software instance to the hosting hardware or virtual CI.</td>
                                </tr>
                                <tr>
                                    <td>Discovery Model</td>
                                    <td><code>discovery_model</code></td>
                                    <td>Reference</td>
                                    <td><code>cmdb_sam_sw_discovery_model</code></td>
                                    <td>Yes</td>
                                    <td>Foreign key linking this install instance to its normalized canonical cluster.</td>
                                </tr>
                                <tr>
                                    <td>Install Status</td>
                                    <td><code>install_status</code></td>
                                    <td>Choice</td>
                                    <td>—</td>
                                    <td>Yes</td>
                                    <td>Current state of the installation: Installed (1) or Absent / Removed (100).</td>
                                </tr>
                                <tr>
                                    <td>Install Date</td>
                                    <td><code>install_date</code></td>
                                    <td>GlideDateTime</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Original date and time the software package was deployed onto the machine.</td>
                                </tr>
                                <tr>
                                    <td>Last Used Date</td>
                                    <td><code>last_used</code></td>
                                    <td>GlideDateTime</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Most recent execution timestamp gathered from OS process monitoring or event logs.</td>
                                </tr>
                                <tr>
                                    <td>Usage Status</td>
                                    <td><code>usage_status</code></td>
                                    <td>Choice</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Categorization: Active Usage (&lt; 30d), Low Usage (30-60d), Inactive (&gt; 90d).</td>
                                </tr>
                                <tr>
                                    <td>Uninstall String</td>
                                    <td><code>uninstall_string</code></td>
                                    <td>String (1000)</td>
                                    <td>—</td>
                                    <td>No</td>
                                    <td>Command-line or MSI execution argument required to silently de-provision the application.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

