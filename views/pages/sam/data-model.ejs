                                    <td>Exact date and time the calculation sequence finished execution.</td>
                                </tr>
                                <tr>
                                    <td>Scope</td>
                                    <td><code>reconciliation_scope</code></td>
                                    <td>Choice</td>
                                    <td>—</td>
                                    <td>Yes</td>
                                    <td>Scope: All Publishers, Single Publisher, or Reconciliation Group (cost center/region).</td>
                                </tr>
                                <tr>
                                    <td>Target Publisher</td>
                                    <td><code>publisher_filter</code></td>
                                    <td>String</td>
                                    <td>—</td>
