                                <div class="data-table-wrapper">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Label</th>
                                                <th>Column Name</th>
                                                <th>Type</th>
                                                <th>Reference Target</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Asset Tag</td>
                                                <td><code>asset_tag</code></td>
                                                <td>String</td>
