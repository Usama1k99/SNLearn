    <!-- Navigation -->
    <%
        const currentModule = (typeof activeModule !== 'undefined' && activeModule) 
            ? activeModule 
            : ((typeof activeTab !== 'undefined' && activeTab !== 'home') ? activeTab : '');
        const currentPage = (typeof activePage !== 'undefined') ? activePage : '';
        const isModule = ['basics', 'itsm', 'ham', 'sam', 'irm', 'secops'].includes(currentModule);
        const isModuleHome = !currentPage || currentPage === 'index';
        
        const MODULE_LABELS = {
            'basics': 'Basics',
            'itsm': 'ITSM',
            'ham': 'HAM',
            'sam': 'SAM',
            'irm': 'IRM',
            'secops': 'SecOps'
        };
        
        const MODULE_PAGE_MAP = {
            'basics': {
                'overview': 'The Big Picture & Overview',
                'pdi-setup': 'Claim PDI & UI Navigation',
                'data-architecture': 'Tables, Records & Sys IDs',
                'forms-and-lists': 'Forms, Lists & Filters',
                'client-scripting': 'UI Policies & Client Scripts',
                'server-scripting': 'Business Rules & Script Includes',
                'flow-designer': 'Flow Designer Automation',
                'security-and-scopes': 'Security, Roles & Update Sets',
                'app-builder-sandbox': 'Custom App Sandbox Lab',
                'career-roadmap': 'Career & Learning Roadmap'
            },
            'itsm': {
                'overview': 'Overview & Architecture',
                'data-model': 'Master Data Model & CSDM',
                'incident-management': 'Incident & Major Incident',
                'problem-management': 'Problem Management & KEDB',
                'change-management': 'Change & Release Management',
                'service-catalog': 'Service Catalog & Requests',
                'knowledge-management': 'Knowledge Management',
                'sla-management': 'Service Level Management',
                'service-operations-workspace': 'Service Operations Workspace',
                'walkup-and-cim': 'Walk-up Experience & CIM',
                'developer-patterns': 'Developer Patterns & APIs',
                'simulator': 'Process Simulator'
            },
            'ham': {
                'overview': 'Overview & Architecture',
                'data-model': 'Asset & CI Data Model',
                'procurement': 'Procurement Lifecycle',
                'inventory': 'Stockrooms & Transfer Orders',
                'disposal': 'Disposal & Retirement',
                'developer-patterns': 'Developer Patterns & APIs',
                'simulator': 'Process Simulator'
            },
            'sam': {
                'overview': 'Overview & Architecture',
                'data-model': 'Data Model & Tables',
                'normalization': 'Discovery & Normalization',
                'saas-and-cloud': 'SaaS & Cloud Subscriptions',
                'entitlements-and-allocations': 'Entitlements & Allocations',
                'reconciliation': 'Reconciliation Engine',
                'remediation': 'Remediation & Reclamation',
                'developer-patterns': 'Developer Patterns & APIs',
                'simulator': 'Process Simulator'
            },
            'irm': {
                'overview': 'Overview & Architecture',
                'data-model': 'Entity Framework & Data Model',
                'risk-lifecycle': 'Risk Management Lifecycle',
                'policy-compliance': 'Policy & Compliance',
                'audit-regulatory': 'Audit & Regulatory Change',
                'tprm': 'Third-Party Risk (TPRM)',
                'operational-resilience': 'Operational Resilience & BCM',
                'continuous-monitoring': 'Continuous Monitoring',
                'issues-remediation': 'Issues & Remediation',
                'developer-patterns': 'Developer Patterns & APIs',
                'simulator': 'Process Simulator'
            },
            'secops': {
                'overview': 'Overview & Architecture',
                'data-model': 'SecOps Data Model',
                'sir-lifecycle': 'SIR Lifecycle & Playbooks',
                'vulnerability-response': 'Vulnerability Response',
                'threat-intelligence': 'Threat Intelligence',
                'developer-patterns': 'Developer Patterns',
                'simulator': 'Process Simulator'
            }
        };
        
        const moduleLabel = MODULE_LABELS[currentModule] || currentModule.toUpperCase();
        let pageLabel = '';
        if (!isModuleHome && MODULE_PAGE_MAP[currentModule] && MODULE_PAGE_MAP[currentModule][currentPage]) {
            pageLabel = MODULE_PAGE_MAP[currentModule][currentPage];
        } else if (!isModuleHome && currentPage) {
            pageLabel = currentPage.split('-').map(s => s.charAt(0).toUpperCase() + s.slice(1)).join(' ');
        }
    %>
    <nav class="navbar" id="navbar">
        <% if (typeof activeTab !== 'undefined' && activeTab !== 'home') { %>
            <div class="scroll-progress-bar"></div>
        <% } %>
        <div class="nav-container">
            <a href="/" class="nav-logo">
                <div class="logo-icon">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <span class="logo-text">SN<span class="logo-accent">Learn</span></span>
            </a>

            <!-- Center Module & Page Indicator -->
            <% if (isModule) { %>
                <div class="nav-center-indicator" id="navCenterIndicator">
                    <div class="nav-module-breadcrumb <%= isModuleHome ? 'is-home' : '' %>">
                        <a href="/<%= currentModule %>" class="nav-module-crumb-link <%= isModuleHome ? 'is-single' : '' %>" title="Return to <%= moduleLabel %> Home">
                            <span class="nav-module-crumb-dot"></span>
                            <span class="nav-module-crumb-title"><%= moduleLabel %></span>
                        </a>
                        <% if (!isModuleHome && pageLabel) { %>
                            <span class="nav-module-crumb-sep">|</span>
                            <span class="nav-module-crumb-page" title="<%= pageLabel %>"><%= pageLabel %></span>
                        <% } %>
                    </div>
                </div>
            <% } else { %>
                <div class="nav-center-indicator" id="navCenterIndicator" style="display: none;"></div>
            <% } %>

            <!-- Mobile Hamburger Toggle Button -->
            <button class="nav-mobile-toggle" id="navMobileToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
                <span class="hamburger-line line-1"></span>
                <span class="hamburger-line line-2"></span>
                <span class="hamburger-line line-3"></span>
            </button>

            <!-- Navigation Links (Desktop Row & Mobile Expandable Menu) -->
            <% const isModuleActive = typeof activeTab !== 'undefined' && ['itsm', 'ham', 'sam', 'irm', 'secops'].includes(activeTab); %>
            <div class="nav-links" id="navLinks">
                <a href="/" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'home' ? 'active' : '' %>">Home</a>
                <a href="/basics" class="nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'basics' ? 'active' : '' %>">Basics</a>

                <!-- Modules Dropdown -->
                <div class="nav-dropdown" id="navModulesDropdown">
                    <button class="nav-link nav-dropdown-btn <%= isModuleActive ? 'active' : '' %>" id="modulesDropdownToggle" aria-haspopup="true" aria-expanded="false" type="button">
                        <span>Modules</span>
                        <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="nav-dropdown-menu" id="modulesDropdownMenu" aria-labelledby="modulesDropdownToggle">
                        <div class="dropdown-header">
                            <span class="dropdown-header-title">ServiceNow Modules</span>
                            <span class="dropdown-header-tag">Core Hub</span>
                        </div>

                        <a href="/itsm" class="dropdown-item <%= typeof activeTab !== 'undefined' && activeTab === 'itsm' ? 'active' : '' %>">
                            <div class="dropdown-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                            </div>
                            <div class="dropdown-item-content">
                                <div class="dropdown-item-title">ITSM</div>
                                <div class="dropdown-item-desc">IT Service Management</div>
                            </div>
                            <% if (typeof activeTab !== 'undefined' && activeTab === 'itsm') { %>
                                <span class="dropdown-item-badge">Active</span>
                            <% } else { %>
                                <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            <% } %>
                        </a>

                        <a href="/ham" class="dropdown-item <%= typeof activeTab !== 'undefined' && activeTab === 'ham' ? 'active' : '' %>">
                            <div class="dropdown-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="2" width="20" height="8" rx="2"></rect>
                                    <rect x="2" y="14" width="20" height="8" rx="2"></rect>
                                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                                </svg>
                            </div>
                            <div class="dropdown-item-content">
                                <div class="dropdown-item-title">HAM</div>
                                <div class="dropdown-item-desc">Hardware Asset Management</div>
                            </div>
                            <% if (typeof activeTab !== 'undefined' && activeTab === 'ham') { %>
                                <span class="dropdown-item-badge">Active</span>
                            <% } else { %>
                                <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            <% } %>
                        </a>

                        <a href="/sam" class="dropdown-item <%= typeof activeTab !== 'undefined' && activeTab === 'sam' ? 'active' : '' %>">
                            <div class="dropdown-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                    <path d="M2 17l10 5 10-5"></path>
                                    <path d="M2 12l10 5 10-5"></path>
                                </svg>
                            </div>
                            <div class="dropdown-item-content">
                                <div class="dropdown-item-title">SAM</div>
                                <div class="dropdown-item-desc">Software Asset Management</div>
                            </div>
                            <% if (typeof activeTab !== 'undefined' && activeTab === 'sam') { %>
                                <span class="dropdown-item-badge">Active</span>
                            <% } else { %>
                                <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            <% } %>
                        </a>

                        <a href="/irm" class="dropdown-item <%= typeof activeTab !== 'undefined' && activeTab === 'irm' ? 'active' : '' %>">
                            <div class="dropdown-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <polyline points="9 12 11 14 15 10"></polyline>
                                </svg>
                            </div>
                            <div class="dropdown-item-content">
                                <div class="dropdown-item-title">IRM</div>
                                <div class="dropdown-item-desc">Integrated Risk Management</div>
                            </div>
                            <% if (typeof activeTab !== 'undefined' && activeTab === 'irm') { %>
                                <span class="dropdown-item-badge">Active</span>
                            <% } else { %>
                                <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            <% } %>
                        </a>

                        <a href="/secops" class="dropdown-item <%= typeof activeTab !== 'undefined' && activeTab === 'secops' ? 'active' : '' %>">
                            <div class="dropdown-item-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    <circle cx="12" cy="11" r="3"></circle>
                                </svg>
                            </div>
                            <div class="dropdown-item-content">
                                <div class="dropdown-item-title">SecOps</div>
                                <div class="dropdown-item-desc">Security Operations</div>
                            </div>
                            <% if (typeof activeTab !== 'undefined' && activeTab === 'secops') { %>
                                <span class="dropdown-item-badge">Active</span>
                            <% } else { %>
                                <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            <% } %>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
